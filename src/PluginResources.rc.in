#include <windows.h>
#include "Resource.h"

IDI_READER_LIGHT ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/reader_light.ico"
IDI_READER_DARK ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/reader_dark.ico"
IDB_READER_TOOLBAR BITMAP "@CMAKE_CURRENT_SOURCE_DIR@/assets/reader_toolbar.bmp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Open source contributors\0"
            VALUE "FileDescription", "Same-pane Markdown Reader for Notepad++\0"
            VALUE "FileVersion", "0.1.0\0"
            VALUE "InternalName", "NppMarkdownReader\0"
            VALUE "LegalCopyright", "Copyright (C) 2026\0"
            VALUE "OriginalFilename", "NppMarkdownReader.dll\0"
            VALUE "ProductName", "NppMarkdownReader\0"
            VALUE "ProductVersion", "0.1.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
